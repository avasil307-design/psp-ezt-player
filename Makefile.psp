TARGET = EZTPlayer
OBJS = src/fb.o src/text.o src/theme.o src/easing.o src/library.o src/ui.o src/app.o \
       src/assets.o src/assets_data.o src/main_psp.o
INCDIR = include assets
CFLAGS = -O2 -G0 -Wall -Wextra -std=c99 -D__PSP__ $(addprefix -I,$(INCDIR))
CXXFLAGS = $(CFLAGS)
ASFLAGS = $(addprefix -I,$(INCDIR))
LIBS = -lm -lpspdisplay -lpspctrl -lpspkernel

BUILD_PRX = 1
PSP_FW_VERSION = 660
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = EZT Video Player

ifndef PSPSDK
PSPSDK := $(shell psp-config --pspsdk-path)
endif
include $(PSPSDK)/lib/build.mak
